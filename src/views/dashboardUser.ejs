<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Panel de Usuario</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <script>
        const token = sessionStorage.getItem('token');
        if (!token) window.location.href = '/signIn';
    </script>
</head>
<body class="grey lighten-4">
    <nav class="teal darken-2">
        <div class="nav-wrapper container">
            <a href="#" class="brand-logo">Área de Usuario</a>
            <ul id="nav-mobile" class="right hide-on-med-and-down">
                <li><a href="/profile">Mi Perfil</a></li>
                <li><a href="#" id="logoutBtn"><i class="material-icons left">exit_to_app</i>Salir</a></li>
            </ul>
        </div>
    </nav>

    <div class="container" style="margin-top: 50px;">
        <div class="row">
            <div class="col s12 m8 offset-m2">
                <div class="card card-panel center-align z-depth-2">
                    <i class="material-icons large teal-text text-darken-2" style="margin-top:20px;">account_circle</i>
                    <h4>¡Bienvenido al Sistema!</h4>
                    <p class="flow-text grey-text text-darken-1">Aquí puedes gestionar tus datos personales y revisar tu configuración de seguridad.</p>
                    <div class="card-action" style="margin-top:30px;">
                        <a href="/profile" class="btn waves-effect waves-light teal">Ir a Mi Cuenta</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('logoutBtn').addEventListener('click', () => {
            sessionStorage.clear();
            window.location.href = '/signIn';
        });
    </script>
</body>
</html>
