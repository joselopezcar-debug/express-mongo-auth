<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Panel de Administración</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <script>
        // Protección de Ruta antes de renderizar la página
        const token = sessionStorage.getItem('token');
        if (!token) window.location.href = '/signIn';
        
        const payload = JSON.parse(atob(token.split('.')[1]));
        if (!payload.roles.includes('admin')) window.location.href = '/403';
    </script>
</head>
<body class="grey lighten-4">
    <nav class="blue darken-3">
        <div class="nav-wrapper container">
            <a href="#" class="brand-logo">Admin Dashboard</a>
            <ul id="nav-mobile" class="right hide-on-med-and-down">
                <li><a href="/profile">Mi Cuenta</a></li>
                <li><a href="#" id="logoutBtn"><i class="material-icons left">exit_to_app</i>Cerrar Sesión</a></li>
            </ul>
        </div>
    </nav>

    <div class="container" style="margin-top: 30px;">
        <div class="card">
            <div class="card-content">
                <span class="card-title font-weight-bold">Usuarios Registrados en el Sistema</span>
                <p class="grey-text">Lista completa de cuentas y niveles de acceso.</p>
                
                <table class="striped responsive-table" style="margin-top: 20px;">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th>Roles</th>
                            <th>Fecha Registro</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="usersTableBody">
                        <!-- Se llena dinámicamente -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal para ver detalle de usuario -->
    <div id="userDetailModal" class="modal">
        <div class="modal-content">
            <h4>Detalle del Usuario</h4>
            <div id="modalContent"></div>
        </div>
        <div class="modal-footer">
            <a href="#!" class="modal-close waves-effect waves-green btn-flat">Cerrar</a>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            // Inicializar Modal de Materialize
            const elems = document.querySelectorAll('.modal');
            M.Modal.init(elems);

            // Botón de cerrar sesión
            document.getElementById('logoutBtn').addEventListener('click', () => {
                sessionStorage.clear();
                window.location.href = '/signIn';
            });

            // Cargar usuarios desde la API
            try {
                const res = await fetch('/api/users', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (!res.ok) throw new Error('Error al obtener usuarios');
                
                const users = await res.json();
                const tbody = document.getElementById('usersTableBody');
                
                users.forEach(user => {
                    const rolesStr = user.roles.map(r => r.name).join(', ');
                    const dateStr = new Date(user.createdAt).toLocaleDateString();
                    
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td>${user.name} ${user.lastName || ''}</td>
                        <td>${user.email}</td>
                        <td>${user.phoneNumber || 'N/A'}</td>
                        <td><span class="chip blue white-text">${rolesStr}</span></td>
                        <td>${dateStr}</td>
                        <td>
                            <button class="btn-small waves-effect waves-light blue lighten-1" onclick="viewUser('${user._id}')">
                                <i class="material-icons">visibility</i>
                            </button>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            } catch (err) {
                M.toast({html: 'No se pudieron cargar los datos', classes: 'red'});
            }
        });

        async function viewUser(id) {
            // Reutilizamos el endpoint /api/users/me o puedes crear /api/users/:id en el backend. 
            // Para cumplir con el botón de ver info, simulamos la búsqueda en el cliente o pegamos a la API:
            const token = sessionStorage.getItem('token');
            const res = await fetch(`/api/users`, { headers: { 'Authorization': `Bearer ${token}` } });
            const users = await res.json();
            const user = users.find(u => u._id === id);

            if(user) {
                const rolesStr = user.roles.map(r => r.name).join(', ');
                document.getElementById('modalContent').innerHTML = `
                    <p><strong>Nombre Completo:</strong> ${user.name} ${user.lastName || ''}</p>
                    <p><strong>Email:</strong> ${user.email}</p>
                    <p><strong>Teléfono:</strong> ${user.phoneNumber || 'N/A'}</p>
                    <p><strong>Dirección:</strong> ${user.address || 'No especificada'}</p>
                    <p><strong>Fecha de Nacimiento:</strong> ${user.birthdate ? new Date(user.birthdate).toLocaleDateString() : 'N/A'}</p>
                    <p><strong>Roles asignados:</strong> ${rolesStr}</p>
                `;
                const instance = M.Modal.getInstance(document.getElementById('userDetailModal'));
                instance.open();
            }
        }
    </script>
</body>
</html>